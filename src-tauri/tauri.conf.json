{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mednafen Play",
  "version": "0.2.3",
  "identifier": "us.gametranslate.mednafen-play",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Mednafen Play · GameTranslate",
        "width": 1240,
        "height": 850,
        "minWidth": 860,
        "minHeight": 620,
        "backgroundColor": "#f7f8f4"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": {
      "resources/engine/": "resources/engine/",
      "resources/mednafen-1.32.1.tar.xz": "resources/mednafen-1.32.1.tar.xz",
      "resources/THIRD-PARTY.txt": "resources/THIRD-PARTY.txt",
      "../HUONG-DAN.md": "HUONG-DAN.md",
      "resources/SDL-LICENSE.txt": "resources/SDL-LICENSE.txt",
      "resources/FRONTEND-LICENSES.txt": "resources/FRONTEND-LICENSES.txt",
      "resources/HOST-MANIFEST.json": "resources/HOST-MANIFEST.json",
      "../PORTS.md": "PORTS.md",
      "../VALIDATION.md": "VALIDATION.md"
    },
    "publisher": "GameTranslate",
    "shortDescription": "A friendly Mednafen library with embedded playback and multilingual settings",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
